# ─── Core ────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-min-32-chars-long
API_BASE_URL=http://localhost:8020

# ─── Database (container-to-container uses 5432/6379) ─
DATABASE_URL=postgresql+asyncpg://sojip_user:sojip_pass@postgres:5432/sojip_db
REDIS_URL=redis://redis:6379/0

# ─── Auth ────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ─── AI Serving ──────────────────────────────────────
AI_BACKEND=ollama
OLLAMA_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3:8b
VLLM_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen3-8B-Instruct
AI_CONTEXT_LENGTH=8192
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# ─── Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8020/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8020/ws

# ─── GitHub Integration ─────────────────────────────
GITHUB_TOKEN=
GITHUB_ORG=sojip-projects

# ─── GitHub OAuth ────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK=http://localhost:8020/api/v1/auth/github/callback
GITHUB_ORG=sojip-projects
TOKEN_ENCRYPTION_KEY=
