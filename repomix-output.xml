"""
Deploy script generator.

One template per deployment target. Produces a shell script the
student can run from their laptop (or in Codespaces).
"""
from typing import Literal


TargetId = Literal[
    "railway", "fly", "vercel", "docker", "codespaces", "custom",
    "github_pages", "npm", "pypi", "chrome_store", "local_network", "download",
]


def _header(project_name, target):
    return chr(10).join([
        "#!/usr/bin/env bash",
        "# Deploy script for " + project_name,
        "# Target: " + target,
        "# Generated by SOJIP",
        "",
        "set -euo pipefail",
        "",
    ])


def _env_block(env_keys):
    if not env_keys:
        return "# --- Environment ---" + chr(10) + "# No env vars configured." + chr(10) + chr(10)
    lines = [
        "# --- Environment ---",
        "# This script sources a local .env file.",
        "# Create one (gitignored) with these keys:",
        "#",
    ]
    for k in env_keys:
        lines.append("#   " + k + "=<your value>")
    lines.extend([
        "#",
        "if [ ! -f .env ]; then",
        "  echo 'Error: .env not found.' >&2",
        "  exit 1",
        "fi",
        "set -a",
        ". ./.env",
        "set +a",
        "",
    ])
    return chr(10).join(lines)


