        Release.tenant_id == ctx.tenant_id,
        Release.project_id == project_id,
    )
    release = (await db.execute(stmt)).scalar_one_or_none()
    if release is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Release not found",
        )
    await db.delete(release)
