        "# --- PyPI ---",
        "PY=$(command -v python3 || command -v python)",
        "$PY -m pip install --upgrade pip build twine",
        "$PY -m build",
        "$PY -m twine upload dist/*",
        "echo 'Verify: https://pypi.org/project/" + pkg + "/'",
        "",
    ])


def _chrome_store_body(slug):
    return chr(10).join([
        "# --- Chrome Web Store ---",
        "BUNDLE='" + slug + "-extension.zip'",
        "rm -f \"$BUNDLE\"",
        "zip -r \"$BUNDLE\" . -x '*.git*' '*.zip'",
        "echo 'Bundle: $BUNDLE'",
        "echo 'Upload at: https://chrome.google.com/webstore/devconsole'",
        "",
    ])


def _local_network_body(slug):
    return chr(10).join([
        "# --- Local network ---",
        "echo 'Detecting local IP...'",
        "if command -v ip > /dev/null; then ip -4 addr show | grep inet; fi",
        "echo 'Starting service on 0.0.0.0...'",
        "if [ -f app.py ]; then python app.py; fi",
        "",
    ])


def _download_body(slug):
    return chr(10).join([
        "# --- GitHub release ---",
        "if ! command -v gh > /dev/null; then",
        "  echo 'Install gh: https://cli.github.com/'",
        "  exit 1",
        "fi",
        "VERSION=${1:-v1.0.0}",
        "gh release create \"$VERSION\" --title \"$VERSION\" --notes 'Release $VERSION'",
        "echo 'Release created.'",
        "",
    ])


# --- Registry ---

_TARGET_BODIES = {
    "railway": _railway_body,
    "fly": _fly_body,
    "vercel": _vercel_body,
    "docker": _docker_body,
    "codespaces": _codespaces_body,
    "custom": _custom_body,
    "github_pages": _github_pages_body,
    "npm": _npm_body,
    "pypi": _pypi_body,
    "chrome_store": _chrome_store_body,
    "local_network": _local_network_body,
    "download": _download_body,
}


def generate_deploy_script(target, project_name, project_slug, env_keys):
    body_fn = _TARGET_BODIES.get(target, _custom_body)
    return _header(project_name, target) + chr(10) + _env_block(env_keys) + body_fn(project_slug)


def generate_env_example(env_keys):
    if not env_keys:
        return "# No env vars defined yet." + chr(10)
    parts = [
        "# Environment variables for this project.",
        "# Copy to .env and fill in real values.",
        "",
    ]
    for k in sorted(env_keys):
        parts.append(k + "=")
    return chr(10).join(parts) + chr(10)
