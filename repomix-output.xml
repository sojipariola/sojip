def render_template(template_id: str, context: dict) -> dict[str, str]:
    """
    Render the files for a template with the given context.

    Uses simple string replacement instead of str.format() so that
    literal `{` and `}` characters in file content (YAML, code fences)
    don't need escaping.

    Context keys: project_name, project_slug, description
    """
    files = TEMPLATE_FILES.get(template_id)
    if not files:
        return {}

    rendered: dict[str, str] = {}
    for path, content in files.items():
        out = content
        for key, value in context.items():
            out = out.replace("{" + key + "}", str(value))
        rendered[path] = out
    return rendered
